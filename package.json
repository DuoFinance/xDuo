{
  "name": "uni2-legacy-neox",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test && forge test",
    "test:hardhat": "hardhat test",
    "test:forge": "forge test -vvv",
    "test:live": "bash scripts/liveTest/runAll.sh anvil",
    "test:all": "npm run test && npm run test:live",
    "anvil": "bash scripts/liveTest/anvil.sh",
    "anvil:setup": "npx hardhat run scripts/liveTest/setupAnvil.ts --network anvil",
    "deploy:bonding:legacy": "hardhat run scripts/deploy.ts --network legacy",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network neoxTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network neoxMainnet",
    "deploy:Duo+Staking:legacy": "hardhat run scripts/deployDuoStaking.ts --network legacy",
    "deploy:Duo+Staking:testnet": "hardhat run scripts/deployStaking.ts --network neoxTestnet",
    "deploy:Duo+Staking:mainnet": "hardhat run scripts/deployStaking.ts --network neoxMainnet",
    "deploy:staking-factory:legacy": "hardhat run scripts/deployStakingFactory.ts --network legacy",
    "deploy:staking-factory:testnet": "hardhat run scripts/deployStakingFactory.ts --network neoxTestnet",
    "deploy:staking-factory:mainnet": "hardhat run scripts/deployStakingFactory.ts --network neoxMainnet",
    "manage:staking:legacy": "hardhat run scripts/manageStaking.ts --network legacy",
    "manage:staking:testnet": "hardhat run scripts/manageStaking.ts --network neoxTestnet",
    "manage:staking:mainnet": "hardhat run scripts/manageStaking.ts --network neoxMainnet"
  },
  "overrides": {
    "adm-zip": ">=0.6.0",
    "bn.js": "^4.12.3",
    "cookie": ">=0.7.0",
    "lodash": "^4.17.24",
    "serialize-javascript": ">=7.0.5",
    "tmp": ">=0.2.6",
    "undici": "^6.21.0",
    "uuid": ">=11.1.1",
    "ws": ">=8.20.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.3",
    "chai": "4.5.0",
    "dotenv": "16.4.5",
    "ethers": "6.15.0",
    "hardhat": "2.28.6",
    "mocha": "10.8.2",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
