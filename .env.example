# ── Anvil (local NeoX mainnet fork) ─────────────────────────────────────────
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=1337
ANVIL_DEPLOYER_PRIVATE_KEY=
ANVIL_EXPLORER_BASE_URL=
ANVIL_WGAS_ADDRESS=
ANVIL_TX_TYPE=auto
ANVIL_GAS_PRICE_GWEI=
ANVIL_MAX_FEE_PER_GAS_GWEI=
ANVIL_MAX_PRIORITY_FEE_PER_GAS_GWEI=
ANVIL_TOTAL_SUPPLY=
ANVIL_TREASURY_ADDRESS=
ANVIL_TOKEN_OWNER=
ANVIL_STAKING_OWNER=
ANVIL_STAKING_REWARD_BLOCKS=
ANVIL_STAKING_REWARD_AMOUNT=
ANVIL_STAKING_FACTORY_OWNER=
# Optional Anvil-specific flags; otherwise DUO_INIT_* below applies.
# ANVIL_INIT_ALLOCATION=false
# ANVIL_INIT_REWARDS=false

# ── NeoX Testnet ────────────────────────────────────────────────────────────
NEOX_TESTNET_RPC_URL=
NEOX_TESTNET_CHAIN_ID=12227332
NEOX_TESTNET_DEPLOYER_PRIVATE_KEY=
NEOX_TESTNET_EXPLORER_BASE_URL=
NEOX_TESTNET_WGAS_ADDRESS=
NEOX_TESTNET_TX_TYPE=auto
NEOX_TESTNET_GAS_PRICE_GWEI=
NEOX_TESTNET_MAX_FEE_PER_GAS_GWEI=
NEOX_TESTNET_MAX_PRIORITY_FEE_PER_GAS_GWEI=
NEOX_TESTNET_ANTI_MEV_RPC_URL=

# ── NeoX Mainnet ────────────────────────────────────────────────────────────
NEOX_MAINNET_RPC_URL=
NEOX_MAINNET_CHAIN_ID=47763
NEOX_MAINNET_DEPLOYER_PRIVATE_KEY=
NEOX_MAINNET_EXPLORER_BASE_URL=
NEOX_MAINNET_WGAS_ADDRESS=
NEOX_MAINNET_TX_TYPE=auto
NEOX_MAINNET_GAS_PRICE_GWEI=
NEOX_MAINNET_MAX_FEE_PER_GAS_GWEI=
NEOX_MAINNET_MAX_PRIORITY_FEE_PER_GAS_GWEI=
NEOX_MAINNET_ANTI_MEV_RPC_URL=

# ── Token / staking deployment parameters ───────────────────────────────────
# DUO_* is the global fallback for every network. For per-network values use
# DUO_TESTNET_* / DUO_MAINNET_* (same suffixes), e.g. DUO_MAINNET_TOTAL_SUPPLY.
# TOTAL_SUPPLY is human-readable (18 decimals); REWARD_AMOUNT is raw base units.
DUO_TOTAL_SUPPLY=
DUO_TREASURY_ADDRESS=
DUO_TOKEN_OWNER=
DUO_STAKING_OWNER=
DUO_STAKING_REWARD_BLOCKS=
DUO_STAKING_FACTORY_OWNER=
DUO_STAKING_REWARD_AMOUNT=
DUO_INIT_ALLOCATION=false
DUO_INIT_REWARDS=false

# ── Safety / test overrides ─────────────────────────────────────────────────
# Only set when intentionally replacing an existing Factory/Router/DuoLaunch:
# ALLOW_REDEPLOY=1
# Verify deployment records without RPC:
# X_VERIFY_OFFLINE=1
# Test/CI only: redirect deployed.*.json / ui-v2 sync output.
# X_DEPLOYED_DIR=
# X_UI_DEPLOYED_CONTRACTS_DIR=
